#!/bin/bash
# pre-commit clean-gate: refuse any commit that stages employer-identifying
# content (same patterns as tools/check-public-clean.sh; self-contained so it
# works on any branch). Mirrors the gate's allowlist and file-type scope.
# Scans the STAGED BLOB (git show :$f), not the worktree file — later edits
# must not hide violations from the commit being made (review).
# Iterates NUL-delimited: paths with spaces are files too (review).
set -u
pat='\bunited\b|united'"'"'s|\bcrew\.|LoggingManager|sonarqube|sonarqube|\bwiz\b|CI in Harness|CI = Harness|lives in GitHub and Harness|~150 repos|150-repo|8 packages compiled|publishes ~8 packages|employment agreement|invention-assignment|outside-work policy|88mph|88mphServer'
fail=0
git diff --cached --name-only -z --diff-filter=ACMR | while IFS= read -r -d '' f; do
  case "$f" in
    docs/COMPARISONS.md|*testdata-ingest*) continue ;;
  esac
  case "$f" in
    *.md|*.json|*.cs|*.mjs|*.props|*.csproj|*.yml|*.config) ;;
    *) continue ;;
  esac
  # the staged blob, never the worktree copy: the commit is what ships
  hit=$(git show ":$f" 2>/dev/null | grep -niE "$pat" | head -1)
  if [ -n "$hit" ]; then
    echo "COMMIT REFUSED [pre-commit clean-gate] $f:$hit" >&2
    echo "  (employer-identifying content; fix or see tools/check-public-clean.sh)" >&2
    fail=1
  fi
  if [ "$fail" = 1 ]; then exit 1; fi
done
[ "${PIPESTATUS[1]:-0}" = 1 ] && exit 1
exit 0
